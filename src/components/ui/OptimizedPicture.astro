---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveSiteImage } from '../../lib/site-images';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  width?: number;
  height?: number;
  quality?: number;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  quality = 80,
  ...attributes
} = Astro.props;

const resolvedSrc = await resolveSiteImage(src);
---

<Picture
  src={resolvedSrc}
  alt={alt}
  formats={['avif', 'webp']}
  quality={quality}
  {...attributes}
/>
