---
interface Stat {
  value: string
  label: string
  href?: string
}

interface Props {
  items: Stat[]
  cellPy?: 'py-5' | 'py-8'
}

const { items = [], cellPy = 'py-8' } = Astro.props;

const cellPyMap = {
  'py-5': 'py-5',
  'py-8': 'py-8',
} as const;

const cellPyClass = cellPyMap[cellPy];
const isExternal = (href?: string) => Boolean(href && /^https?:\/\//.test(href));
---

<section class="bg-coastal-text-main" data-trust-bar>
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-coastal-bg-pure/10">
      {items.map((stat) => (
        stat.href ? (
          <a
            href={stat.href}
            target={isExternal(stat.href) ? '_blank' : undefined}
            rel={isExternal(stat.href) ? 'noopener noreferrer' : undefined}
            class={`group flex flex-col items-center justify-center ${cellPyClass} px-4 gap-1 text-center transition-colors duration-200 hover:bg-coastal-bg-pure/5`}
          >
            <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-coastal-coral" set:html={stat.label} />
            <span class="text-sm text-coastal-gold-accent group-hover:text-coastal-bg-pure transition-colors" set:html={stat.value} />
          </a>
        ) : (
          <div class={`flex flex-col items-center justify-center ${cellPyClass} px-4 gap-1 text-center`}>
            <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-coastal-coral" set:html={stat.label} />
            <span class="text-sm text-coastal-bg-card" set:html={stat.value} />
          </div>
        )
      ))}
    </div>
  </div>
</section>
