---
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const GA_SRC = GA_ID
  ? `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(GA_ID)}`
  : '';
---

{GA_ID && (
  <>
    <script is:inline async src={GA_SRC}></script>
    <script is:inline define:vars={{ GA_ID }}>
      (function () {
        var NEW_KEY = 'lilos-privacy-v1';
        var OLD_KEY = 'lilos-consent-v1';

        function readOptOut() {
          try {
            var raw = localStorage.getItem(NEW_KEY);
            if (raw) {
              var parsed = JSON.parse(raw);
              if (parsed && typeof parsed.optOut === 'boolean') return parsed.optOut;
            }

            var oldRaw = localStorage.getItem(OLD_KEY);
            if (oldRaw) {
              var old = JSON.parse(oldRaw);
              if (old && old.analytics === false) {
                localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: true, ts: Date.now() }));
                return true;
              }
            }
          } catch (e) {}
          return false;
        }

        function writeOptOut(value) {
          try {
            localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: value, ts: Date.now() }));
          } catch (e) {}
        }

        var privacyDisabled = navigator.globalPrivacyControl === true || readOptOut();
        window['ga-disable-' + GA_ID] = privacyDisabled;

        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', GA_ID);

        window.lilosPrivacy = {
          isOptedOut: function () {
            return readOptOut();
          },
          optOut: function () {
            writeOptOut(true);
            window['ga-disable-' + GA_ID] = true;
          },
          optIn: function () {
            writeOptOut(false);
            window['ga-disable-' + GA_ID] = false;
            if (typeof window.gtag === 'function') {
              window.gtag('config', GA_ID);
            }
          }
        };

        document.addEventListener('click', function (e) {
          var target = e.target;
          if (!(target instanceof Element)) return;

          var link = target.closest('a[href*="toasttab.com"], a[href*="toast.app"], a[href^="tel:"]');
          if (!link) return;

          var eventName = 'toast_link_click';

          if (link.href.startsWith('tel:')) {
            eventName = 'phone_click';
          } else {
            try {
              var host = new URL(link.href).hostname;
              if (host === 'toast.app' || host.endsWith('.toast.app') || host.includes('tables.toasttab.com')) {
                eventName = 'reservation_click';
              } else if (host.includes('order.toasttab.com')) {
                eventName = 'order_click';
              } else if (link.href.includes('invoice/lead')) {
                eventName = 'inquiry_form_click';
              } else if (link.href.toLowerCase().includes('gift')) {
                eventName = 'gift_card_click';
              }
            } catch (err) {}
          }

          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, {
              link_url: link.href,
              page_path: window.location.pathname,
            });
          }
        }, { passive: true });
      })();
    </script>
  </>
)}
