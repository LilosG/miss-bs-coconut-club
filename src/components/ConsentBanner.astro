---
interface Props {
  siteName: string;
  privacyPolicyUrl?: string;
}

const {
  siteName,
  privacyPolicyUrl = '/privacy',
} = Astro.props;
---

<div id="lilos-consent-banner" class="lilos-consent-banner" role="region" aria-live="polite" aria-label="Privacy notice" hidden>
  <div class="lilos-consent-inner">
    <p class="lilos-consent-text">
      {siteName} uses Google Analytics to measure site traffic. We do not sell or share your personal information. You can opt out at any time.
    </p>
    <div class="lilos-consent-actions">
      <button type="button" id="lilos-notice-optout" class="lilos-btn lilos-btn-secondary">Opt out</button>
      <a href={privacyPolicyUrl} class="lilos-btn lilos-btn-secondary">Privacy Policy</a>
      <button type="button" id="lilos-notice-gotit" class="lilos-btn lilos-btn-primary">Got it</button>
    </div>
  </div>
</div>

<style>
  .lilos-consent-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: var(--color-coastal-text-main, #1f1a17);
    color: var(--color-coastal-bg-sand, #f6efe5);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1rem 1.25rem;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.2);
  }

  .lilos-consent-banner[hidden] { display: none; }

  .lilos-consent-inner {
    max-width: 80rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lilos-consent-text {
    margin: 0;
    max-width: 48rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .lilos-consent-actions {
    display: flex;
    gap: 0.625rem;
    flex-shrink: 0;
    align-items: center;
  }

  .lilos-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .lilos-btn-primary {
    background: var(--color-coastal-coral, #d86b45);
    color: white;
  }

  .lilos-btn-secondary {
    background: transparent;
    color: inherit;
    border-color: rgba(255, 255, 255, 0.35);
  }

  @media (max-width: 640px) {
    .lilos-consent-inner { flex-direction: column; align-items: stretch; }
    .lilos-consent-actions { justify-content: flex-end; flex-wrap: wrap; }
  }
</style>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'lilos-privacy-v1';

    function readRecord() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (parsed && typeof parsed.optOut === 'boolean') return parsed;
      } catch (e) {}
      return null;
    }

    function writeRecord(optOut) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ optOut: optOut, ts: Date.now() }));
      } catch (e) {}
    }

    function hideBanner() {
      var el = document.getElementById('lilos-consent-banner');
      if (el) el.hidden = true;
    }

    function showBanner() {
      var el = document.getElementById('lilos-consent-banner');
      if (el) el.hidden = false;
    }

    function init() {
      if (navigator.globalPrivacyControl === true) return;
      if (readRecord() !== null) return;

      showBanner();

      var gotItBtn = document.getElementById('lilos-notice-gotit');
      var optOutBtn = document.getElementById('lilos-notice-optout');

      if (gotItBtn) {
        gotItBtn.addEventListener('click', function () {
          writeRecord(false);
          hideBanner();
        });
      }

      if (optOutBtn) {
        optOutBtn.addEventListener('click', function () {
          if (window.lilosPrivacy && typeof window.lilosPrivacy.optOut === 'function') {
            window.lilosPrivacy.optOut();
          } else {
            writeRecord(true);
          }
          hideBanner();
        });
      }
    }

    window.lilosNotice = {
      reset: function () {
        try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
        showBanner();
      }
    };
    window.lilosConsent = window.lilosNotice;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
